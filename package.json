{
  "name": "gaskiyya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --mode site",
    "dev:console": "vite --mode console",
    "dev:sandbox": "vite --mode sandbox",
    "build": "pnpm typecheck && pnpm build:ui",
    "build:ui": "pnpm build:site && pnpm build:console",
    "build:site": "vite build --mode site && vite build --mode sandbox",
    "build:console": "vite build --mode console",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.app.json"
  },
  "dependencies": {
    "@gaskiya/canonical": "workspace:^",
    "@gaskiya/licences": "workspace:^",
    "@gaskiya/schemas": "workspace:^",
    "@noble/hashes": "1.8.0",
    "motion": "12.23.12",
    "react": "^19",
    "react-dom": "^19",
    "thinking-orbs": "0.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "zod": "^4"
  }
}
