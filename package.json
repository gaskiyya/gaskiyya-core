{
  "name": "gaskiyya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "vite --mode site",
    "dev:console": "vite --mode console",
    "dev:sandbox": "vite --mode sandbox",
    "dev:admin": "vite --mode admin",
    "dev:admin-login": "vite --mode admin-login",
    "build": "pnpm typecheck && pnpm build:ui",
    "build:ui": "pnpm build:site && pnpm build:console && pnpm build:admin",
    "build:site": "vite build --mode site && vite build --mode sandbox",
    "build:console": "vite build --mode console",
    "build:admin": "vite build --mode admin && vite build --mode admin-login",
    "web:build": "pnpm build:ui",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.app.json",
    "demo:offline": "node scripts/demo-offline.mjs",
    "sync:copy": "node scripts/sync-copy.mjs",
    "test": "vitest run && node scripts/flutter.mjs test",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@gaskiya/canonical": "workspace:^",
    "@gaskiya/licences": "workspace:^",
    "@gaskiya/schemas": "workspace:^",
    "@noble/hashes": "1.8.0",
    "motion": "12.23.12",
    "react": "^19",
    "react-dom": "^19",
    "thinking-orbs": "0.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gaskiya/agent": "workspace:^",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@gaskiya/test-vectors": "workspace:^",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jose": "^6.2.12",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zod": "^4"
  }
}
