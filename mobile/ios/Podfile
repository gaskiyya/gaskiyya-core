# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      if Gem::Version.new(config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] || '0') < Gem::Version.new('15.5')
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      end
    end
  end
  leave_mlkit_out_of_simulator(installer)
end

# ML Kit has no arm64 simulator slice: simulator builds use the stubs in SimulatorStubs/ and skip ML Kit.
MLKIT_PLUGINS = %w[google_mlkit_commons google_mlkit_text_recognition].freeze
MLKIT_FRAMEWORKS = %w[MLImage MLKitCommon MLKitTextRecognition MLKitTextRecognitionCommon MLKitVision].freeze
SIM = '[sdk=iphonesimulator*]'.freeze

def leave_mlkit_out_of_simulator(installer)
  project = installer.pods_project
  stubs = project.main_group.find_subpath('SimulatorStubs', true)
  installer.pods_project.targets.each do |target|
    target.build_configurations.each { |c| c.build_settings["EXCLUDED_ARCHS#{SIM}"] = '' }
    next unless MLKIT_PLUGINS.include?(target.name)
    stub = File.expand_path("SimulatorStubs/#{target.name == 'google_mlkit_commons' ? 'GoogleMlKitCommonsPlugin' : 'GoogleMlKitTextRecognitionPlugin'}+Simulator.swift", __dir__)
    target.add_file_references([stubs.files.find { |f| f.real_path.to_s == stub } || stubs.new_file(stub)])
    target.build_configurations.each do |c|
      c.build_settings["EXCLUDED_SOURCE_FILE_NAMES#{SIM}"] = 'GoogleMlKit*Plugin.swift GenericModelManager.swift MLKVisionImage+FlutterPlugin.swift'
      c.build_settings["INCLUDED_SOURCE_FILE_NAMES#{SIM}"] = '*+Simulator.swift'
    end
  end
  project.save
  # Flutter excludes arm64 for the whole app if any pod xcconfig does.
  Dir.glob(File.join(installer.sandbox.target_support_files_root, '*', '*.xcconfig')).each do |path|
    text = File.read(path)
    File.write(path, text) if text.gsub!(/^EXCLUDED_ARCHS\[sdk=iphonesimulator\*\] = arm64\n/, '')
  end
  installer.aggregate_targets.each do |aggregate|
    aggregate.xcconfigs.each do |name, xcconfig|
      path = aggregate.xcconfig_path(name)
      text = File.read(path).gsub(/^EXCLUDED_ARCHS\[sdk=iphonesimulator\*\] = arm64\n/, '')
      ldflags = text[/^OTHER_LDFLAGS = (.*)$/, 1]
      if ldflags
        sim = MLKIT_FRAMEWORKS.reduce(ldflags.sub('$(inherited) ', '')) { |flags, f| flags.gsub(%( -framework "#{f}"), '') }
        text += "OTHER_LDFLAGS#{SIM} = #{sim}\n"
      end
      File.write(path, text)
    end
  end
end
